
стат метод Запустить():
	поле А = 5
	пока А бш 6:
		Консоль.Вывод("Эта строка не должна быть напечатана\н")

	поле Б = 0
	пока Б мш 5:
		Консоль.Вывод("Б = ")
		Консоль.Вывод(Б)
		Консоль.Вывод("\н")
